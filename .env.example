DISCORD_TOKEN=
DATA_DIR=./state
# Optional. User-account credential goes only in the hosting secrets or private
# .env, never in this tracked example. Enables the isolated banner reader.
SECONDARY_ACCOUNT_TOKEN=
# Key from a Groq account kept on the Free plan. Save as a hosting secret.
GROQ_API_KEY=
# Optional model override; default is openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b
